{
  "sourceLanguage" : "en",
  "strings" : {
    "About me" : {
      "comment" : "Title displayed at the top of the About screen.",
      "localizations" : {
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minust"
          }
        }
      }
    },
    "aboutMeDescription" : {
      "comment" : "Paragraph introducing the developer on the About screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hey 👋! My name is Andrius. I'm an iOS Developer from Estonia 🇪🇪. Besides being full-time developer and father of three I'm writing small apps like this. If you have any questions/concerns regarding the app, do not hesitate to contact me."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tere 👋! Minu nimi on Andrius. Olen Eestis elav ja tegutsev iOSi arendaja. Lisaks täiskohaga tööle arendajana kasvatan kolme last ja vabal ajal meeldib mulle kirjutada selliseid väikeseid äppe. Kui teil on seoses äpiga mingeid küsimusi või muresid, võtke minuga kindlasti ühendust."
          }
        }
      }
    },
    "Check Estonian weather forecast." : {
      "comment" : "Widget description shown in the widget gallery.",
      "localizations" : {
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaata Eesti ilmaprognoosi."
          }
        }
      }
    },
