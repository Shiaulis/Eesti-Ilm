{
  "sourceLanguage" : "en",
  "strings" : {
    "About me" : {
      "comment" : "Title displayed at the top of the About screen.",
      "localizations" : {
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minust"
          }
        }
      }
    },
    "aboutMeDescription" : {
      "comment" : "Paragraph introducing the developer on the About screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hey 👋! My name is Andrius. I'm an iOS Developer from Estonia 🇪🇪. Besides being full-time developer and father of three I'm writing small apps like this. If you have any questions/concerns regarding the app, do not hesitate to contact me."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tere 👋! Minu nimi on Andrius. Olen Eestis elav ja tegutsev iOSi arendaja. Lisaks täiskohaga tööle arendajana kasvatan kolme last ja vabal ajal meeldib mulle kirjutada sellised väikesi äppe. Kui teil on seoses äpiga mingeid küsimusi või muresid, võtke minuga kindlasti ühendust."
          }
        }
      }
    },
    "Contact me" : {
      "comment" : "Button label allowing users to contact the developer.",
      "localizations" : {
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Võta ühendust"
          }
        }
      }
    },
    "Could not load tips: %@" : {
      "comment" : "Error message shown when tip products fail to load. The argument is the underlying error message.",
      "localizations" : {
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toetusvalikute laadimine ebaõnnestus: %@"
          }
        }
      }
    },
    "Current language" : {
      "comment" : "Row label in Settings showing the app's active language.",
      "localizations" : {
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praegune keel"
          }
        }
      }
    },
