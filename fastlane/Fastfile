default_platform(:ios)

platform :ios do
  desc "Upload App Store metadata from fastlane/metadata (no binary, no screenshots)"
  desc "Pass version:X.Y.Z to create or select that editable App Store version first;"
  desc "without it, the metadata goes to the existing editable version and no version is changed"
  lane :metadata do |options|
    version = options[:version]

    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY")
    )

    deliver(
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      metadata_path: "./fastlane/metadata",
      run_precheck_before_submit: false,
      # Only an explicit version may create or change the App Store version,
      # never one read from a stray *.ipa in the repo root.
      app_version: version,
      skip_app_version_update: version.nil?
    )
  end

  desc "Upload App Store screenshots from fastlane/screenshots, replacing the existing ones"
  desc "(no metadata, no binary; run fastlane metadata for the text)"
  lane :screenshots do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY")
    )

    deliver(
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      force: true,
      screenshots_path: "./fastlane/screenshots",
      run_precheck_before_submit: false,
      skip_app_version_update: true
    )
  end

  desc "Archive the EstonianWeather scheme (app + widget) and upload it to TestFlight"
  desc "Signs with Xcode automatic signing and cloud-managed certificates through the App Store Connect API key"
  desc "(no certificates, profiles or match); the build number is the latest TestFlight build number + 1"
  lane :beta do
    key_id = ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID")
    issuer_id = ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID")
    key_content = ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content
    )

    build_number = latest_testflight_build_number(api_key: api_key) + 1
    UI.message("Building with build number #{build_number}")

    # xcodebuild reads the key from a file, so write it to a temp file for the
    # duration of the build and always delete it afterwards.
    Dir.mktmpdir("asc-api-key") do |dir|
      key_path = File.join(dir, "AuthKey_#{key_id}.p8")
      File.write(key_path, key_content, perm: 0o600)

      signing_args = [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath", key_path,
        "-authenticationKeyID", key_id,
        "-authenticationKeyIssuerID", issuer_id
      ]

      build_app(
        project: "EstonianWeather.xcodeproj",
        scheme: "EstonianWeather",
        configuration: "Release",
        destination: "generic/platform=iOS",
        export_options: {
          method: "app-store-connect",
          signingStyle: "automatic"
        },
        # Automatic signing: Xcode creates and fetches the certificate and profiles.
        skip_profile_detection: true,
        xcargs: [*signing_args, "CURRENT_PROJECT_VERSION=#{build_number}"].shelljoin,
        export_xcargs: signing_args.shelljoin,
        output_directory: "build",
        clean: true
      )
    end

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
