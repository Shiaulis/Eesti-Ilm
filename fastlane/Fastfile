require "json"
require "open3"

default_platform(:ios)

platform :ios do
  desc "Upload App Store metadata from fastlane/metadata (no binary, no screenshots)"
  desc "Pass version:X.Y.Z to create or select that editable App Store version first;"
  desc "without it, the metadata goes to the existing editable version and no version is changed"
  lane :metadata do |options|
    version = options[:version]

    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY")
    )

    deliver(
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      metadata_path: "./fastlane/metadata",
      run_precheck_before_submit: false,
      # Only an explicit version may create or change the App Store version,
      # never one read from a stray *.ipa in the repo root.
      app_version: version,
      skip_app_version_update: version.nil?
    )
  end

  desc "Upload App Store screenshots from fastlane/screenshots, replacing the existing ones"
  desc "(no metadata, no binary; run fastlane metadata for the text)"
  lane :screenshots do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY")
    )

    deliver(
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      force: true,
      screenshots_path: "./fastlane/screenshots",
      run_precheck_before_submit: false,
      skip_app_version_update: true
    )
  end

  desc "Archive the EstonianWeather scheme (app + widget) and upload it to TestFlight"
  desc "Signs with Xcode automatic signing and cloud-managed certificates through the App Store Connect API key"
  desc "(no certificates, profiles or match); the version and build number come from the Xcode project,"
  desc "and the lane fails before archiving if App Store Connect already has that build"
  lane :beta do
    key_id = ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID")
    issuer_id = ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID")
    key_content = ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content
    )

    # gym (build_app) cannot be used: it reads the project through the xcodeproj gem,
    # which does not support the JSON project format (project.xcproj). Call xcodebuild directly.
    root = File.expand_path("..", __dir__)

    # The uploaded version and build number are the project's own (MARKETING_VERSION and
    # CURRENT_PROJECT_VERSION), so the lane never computes them. Each new upload needs a PR that raises
    # CURRENT_PROJECT_VERSION first.
    # Capture stdout only: xcodebuild prints destination warnings to stderr.
    settings_json, settings_status = Open3.capture2(
      "xcodebuild", "-showBuildSettings",
      "-project", File.join(root, "EstonianWeather.xcodeproj"),
      "-scheme", "EstonianWeather",
      "-configuration", "Release",
      "-destination", "generic/platform=iOS",
      "-json"
    )
    UI.user_error!("xcodebuild -showBuildSettings failed") unless settings_status.success?
    build_settings = JSON.parse(settings_json).first.fetch("buildSettings")
    bundle_id = build_settings.fetch("PRODUCT_BUNDLE_IDENTIFIER")
    version = build_settings.fetch("MARKETING_VERSION")
    build_number = build_settings.fetch("CURRENT_PROJECT_VERSION")
    UI.message("Project version #{version} (#{build_number})")

    # Fail before the slow archive if App Store Connect already has this build. The builds list also
    # contains expired builds. (latest_testflight_build_number is not used: it reads build uploads,
    # which miss older builds.)
    app = Spaceship::ConnectAPI::App.find(bundle_id)
    UI.user_error!("No app with bundle id #{bundle_id} found on App Store Connect") if app.nil?
    existing_builds = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      version: version,
      build_number: build_number
    )
    unless existing_builds.empty?
      UI.user_error!(
        "App Store Connect already has version #{version} build #{build_number}. " \
        "Raise CURRENT_PROJECT_VERSION in a PR first (app, widget and frameworks stay in sync), then run again."
      )
    end

    build_dir = File.join(root, "build")
    archive_path = File.join(build_dir, "EstonianWeather.xcarchive")
    export_path = File.join(build_dir, "export")
    FileUtils.rm_rf(build_dir)
    FileUtils.mkdir_p(build_dir)

    export_options_path = File.join(build_dir, "ExportOptions.plist")
    File.write(export_options_path, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key>
        <string>app-store-connect</string>
        <key>signingStyle</key>
        <string>automatic</string>
        <key>uploadSymbols</key>
        <true/>
      </dict>
      </plist>
    PLIST

    # xcodebuild reads the API key from a file, so write it to a temp file for the
    # duration of the build and always delete it afterwards.
    Dir.mktmpdir("asc-api-key") do |dir|
      key_path = File.join(dir, "AuthKey_#{key_id}.p8")
      File.write(key_path, key_content, perm: 0o600)

      signing_args = [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath", key_path,
        "-authenticationKeyID", key_id,
        "-authenticationKeyIssuerID", issuer_id
      ]

      sh(
        "xcodebuild", "archive",
        "-project", File.join(root, "EstonianWeather.xcodeproj"),
        "-scheme", "EstonianWeather",
        "-configuration", "Release",
        "-destination", "generic/platform=iOS",
        "-archivePath", archive_path,
        *signing_args
      )

      sh(
        "xcodebuild", "-exportArchive",
        "-archivePath", archive_path,
        "-exportPath", export_path,
        "-exportOptionsPlist", export_options_path,
        *signing_args
      )
    end

    ipa_path = Dir[File.join(export_path, "*.ipa")].first
    UI.user_error!("No .ipa found in #{export_path}") if ipa_path.nil?

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )

    summary_path = ENV["GITHUB_STEP_SUMMARY"]
    unless summary_path.nil? || summary_path.empty?
      File.open(summary_path, "a") { |file| file.puts("Uploaded to TestFlight: #{version} (#{build_number})") }
    end
  end
end
